DATABASE_URL=sqlite:///career_readiness.db
# Google OAuth: create a Web application OAuth client and set the redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8501
# IndianAPI Jobs: documented endpoint from the supplied OpenAPI specification.
INDIANAPI_JOBS_URL=https://jobs.indianapi.in/jobs
INDIANAPI_JOBS_KEY=
# Groq: optional. The deterministic fallback stays active if blank.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
